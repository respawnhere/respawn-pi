{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://respawnpack.dev/schemas/state.schema.json",
  "title": "docs/derived/STATE.json — the compiled durable projection",
  "description": "GENERATED by kernel/lib/state.js write(). additionalProperties is FALSE: this pack writes every field, so an undeclared one means a writer changed and this declaration did not. The two shapes are a real fork, not an accident — with no approved requirement source the compiler emits a deliberately smaller document rather than zero-filled counts, because a zero count reads as an answer.",
  "type": "object",
  "required": [
    "schemaVersion", "generatedAt", "sourceRevision", "sourceManifest",
    "tracksRequirements", "cannotDetermine", "ongoingGoalId", "goal",
    "goalComplete", "goalCompletion", "milestone", "currentAtomicTask",
    "constraints", "forbidden", "killedFeatures", "removals", "reconciliation"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "generatedBy": { "type": "string" },
    "sourceRevision": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "sourceManifest": { "$ref": "#/$defs/manifest" },
    "tracksRequirements": { "type": "boolean" },
    "denominatorVersion": { "type": ["string", "null"] },
    "ongoingGoalId": { "type": ["string", "null"] },
    "goal": { "type": ["string", "null"] },
    "forbidden": { "type": "array", "items": { "type": "string" } },
    "authority": { "type": "array", "items": { "type": "string" } },
    "milestone": { "type": ["string", "null"] },
    "milestoneComplete": { "type": "boolean" },
    "goalComplete": { "type": "boolean" },
    "goalCompletion": {
      "type": "object",
      "required": ["status", "criteria", "why"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["MET", "UNMET", "CANNOT_DETERMINE", "NOT_APPLICABLE"] },
        "why": { "type": "string" },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "kind", "status", "detail"],
            "additionalProperties": false,
            "properties": {
              "text": { "type": "string" },
              "kind": { "enum": ["all-mandatory-conformant", "no-open-p0", "no-open-p0p1", "gate-complete", "owner-confirmed", "manual"] },
              "status": { "enum": ["MET", "UNMET", "CANNOT_DETERMINE"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "description": "Every field recomputed from rows on every run. DF-011: nothing here is ever copied forward.",
      "required": ["total", "mandatory", "conformant", "candidate", "unevidenced", "waived", "blocked", "staleEvidence"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "mandatory": { "type": "integer", "minimum": 0 },
        "conformant": { "type": "integer", "minimum": 0 },
        "candidate": { "type": "integer", "minimum": 0 },
        "unevidenced": { "type": "integer", "minimum": 0 },
        "waived": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "staleEvidence": { "type": "integer", "minimum": 0 }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "mandatory", "risk", "priority", "gate", "status", "why", "evidence", "blockedBy", "claimTypes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "mandatory": { "type": "boolean" },
          "risk": { "type": "string" },
          "priority": { "type": ["string", "null"] },
          "gate": { "type": ["string", "null"] },
          "status": {
            "description": "`candidate` is a real status, not a synonym for done: a high-risk row cannot reach `conformant` on implementer-qualified evidence (R-3).",
            "enum": ["conformant", "candidate", "unevidenced", "waived"]
          },
          "why": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "blockedBy": { "type": "array", "items": { "type": "string" } },
          "claimTypes": { "type": "array", "items": { "$ref": "#/$defs/claimType" } }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "denominator", "conformant", "complete", "missingRows", "status", "note"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "denominator": {
            "description": "From the APPROVED requirement source. A declared id with no backing row is a FAIL, never a smaller denominator (R-4).",
            "type": "integer", "minimum": 0
          },
          "conformant": { "type": "integer", "minimum": 0 },
          "complete": { "type": "boolean" },
          "missingRows": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["COMPLETE", "INCOMPLETE", "INCOMPLETE_MISSING_ROWS"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "openP0P1": { "type": "array", "items": { "type": "string" } },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "blockedBy"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "blockedBy": { "type": "array", "items": { "type": "string" } },
          "missingAuthority": {}
        }
      }
    },
    "transitivelyBlocked": { "type": "array", "items": { "type": "string" } },
    "projectBlocked": { "type": "boolean" },
    "currentAtomicTask": { "type": ["string", "null"] },
    "nextUnblockedWork": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "string" } }
      }
    },
    "lastQualified": {
      "type": ["object", "null"],
      "required": ["revision", "at"],
      "additionalProperties": false,
      "properties": { "revision": { "type": ["string", "null"] }, "at": { "type": "string" } }
    },
    "evidence": {
      "type": "object",
      "description": "Rejections are RECORDED, never silent: an artifact that contributes nothing is otherwise indistinguishable from one that was never written.",
      "required": ["accepted", "rejected"],
      "additionalProperties": false,
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "reason"],
            "additionalProperties": false,
            "properties": { "file": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "killedFeatures": {
      "type": "array",
      "description": "Two provenances in one array: registry rows, and legacy goal.json entries with no registry row (which are re-labelled `unverified` rather than dropped). additionalProperties is TRUE because a legacy entry carries the founder's own keys.",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "feature": { "type": "string" },
          "status": { "enum": ["clear", "violated", "unverified"] },
          "risk": { "enum": ["high", "normal"] },
          "why": { "type": "string" },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file", "phrase", "line", "text"],
              "additionalProperties": false,
              "properties": { "file": { "type": "string" }, "phrase": { "type": "string" }, "line": { "type": "integer" }, "text": { "type": "string" } }
            }
          }
        }
      }
    },
    "removals": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "CANNOT_DETERMINE", "NOT_APPLICABLE"] },
        "why": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "string" }] },
        "rows": { "type": "array" },
        "scannedFiles": { "type": "integer", "minimum": 0 },
        "scannedDirs": { "type": "array", "items": { "type": "string" } },
        "extensions": { "type": "array", "items": { "type": "string" } },
        "notScanned": { "type": "array", "items": { "type": "string" } },
        "unreadable": { "type": "array", "items": { "type": "string" } },
        "scannedAtRevision": { "type": ["string", "null"] },
        "corpusManifest": { "$ref": "#/$defs/manifest" }
      }
    },
    "reconciliation": {
      "description": "DF-005. ⛔ THE VERDICT TRAVELS; THE RECORDS DO NOT. Only the outcome, its counts and a bounded list of drifting identifiers are compiled here. Boot may summarise an ESTABLISHED drift without any hook reading a project's task file — injecting unverified project records into a session as truth is precisely the thing this comparison exists to catch someone doing.",
      "type": "object",
      "required": ["status", "why", "counts", "driftIds", "driftTruncated"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["PASS", "DRIFT", "NOT_CONFIGURED", "NOT_APPLICABLE", "CANNOT_DETERMINE"] },
        "why": { "type": "string" },
        "counts": {
          "type": "object",
          "required": ["tasks", "project", "drift"],
          "additionalProperties": false,
          "properties": {
            "tasks": { "type": "integer", "minimum": 0 },
            "project": { "type": "integer", "minimum": 0 },
            "drift": { "type": "integer", "minimum": 0 }
          }
        },
        "driftIds": { "type": "array", "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Z_]+:" } },
        "driftTruncated": { "type": "boolean" }
      }
    },
    "cannotDetermine": { "type": "array", "items": { "type": "string" } }
  },
  "oneOf": [
    {
      "title": "tracked — an approved requirement source exists",
      "required": ["generatedBy", "counts", "requirements", "gates", "openP0P1", "blockers", "transitivelyBlocked", "projectBlocked", "nextUnblockedWork", "evidence", "authority", "milestoneComplete"],
      "properties": { "tracksRequirements": { "const": true } }
    },
    {
      "title": "untracked — no approved requirement source, so no counts are emitted at all",
      "properties": { "tracksRequirements": { "const": false } },
      "not": { "anyOf": [{ "required": ["counts"] }, { "required": ["requirements"] }, { "required": ["gates"] }] }
    }
  ],
  "$defs": {
    "claimType": {
      "description": "Weakest to strongest (R-13), recorded so a unit-test success can never be summarised as an end-to-end capability.",
      "enum": ["untriaged", "inferred", "source-inspected", "unit-tested", "served-boundary tested", "real-engine qualified", "owner-waived"]
    },
    "manifest": {
      "description": "Content-bound freshness. `ABSENT` and `UNREADABLE` are literal sentinels, so adding a file is itself a change.",
      "type": ["object", "null"],
      "required": ["algorithm", "inputs"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "inputs": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "string", "pattern": "^([0-9a-f]{64}|ABSENT|UNREADABLE)$" }
        }
      }
    }
  }
}
