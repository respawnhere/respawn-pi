{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://respawnpack.dev/schemas/evidence.schema.json",
  "title": ".respawnpack/runtime/evidence/*.json — runner-generated qualification artifact",
  "description": "Generated only by scripts/evidence-runner.mjs. Freshness and semantic hashes are rechecked by scripts/completion-contract.mjs; authored file fields and unknown keys fail closed.",
  "type": "object",
  "required": [
    "schemaVersion", "producer", "requirementId", "fenceId", "sourceRevision", "candidateTree",
    "requirementHash", "fenceHash", "witnessHash", "verdict", "exitCode", "qualification",
    "dimensions", "controls", "startedAt", "finishedAt", "durationMs", "output"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "producer": { "const": "scripts/evidence-runner.mjs" },
    "requirementId": { "type": "string", "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "fenceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateTree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "requirementHash": { "$ref": "#/$defs/digest" },
    "fenceHash": { "$ref": "#/$defs/digest" },
    "witnessHash": { "$ref": "#/$defs/digest" },
    "verdict": { "enum": ["PASS", "FAIL", "CANNOT_DETERMINE"] },
    "exitCode": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
    "qualification": { "enum": ["implementer", "independent"] },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "controls": {
      "type": "object",
      "required": ["positive", "negative"],
      "additionalProperties": false,
      "properties": {
        "positive": { "enum": ["PASS", "FAIL", "CANNOT_DETERMINE"] },
        "negative": { "enum": ["PASS", "FAIL", "CANNOT_DETERMINE"] }
      }
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "finishedAt": { "$ref": "#/$defs/timestamp" },
    "durationMs": { "type": "integer", "minimum": 0, "maximum": 600000 },
    "output": {
      "type": "object",
      "required": ["stdoutSha256", "stderrSha256", "stdoutBytes", "stderrBytes", "truncated"],
      "additionalProperties": false,
      "properties": {
        "stdoutSha256": { "$ref": "#/$defs/digest" },
        "stderrSha256": { "$ref": "#/$defs/digest" },
        "stdoutBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "stderrBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "truncated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "stringSet": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^.{1,128}$" } },
    "dimensions": {
      "type": "object",
      "required": ["surface", "topology", "adversarial", "runtime", "qualification"],
      "additionalProperties": false,
      "properties": {
        "surface": { "$ref": "#/$defs/stringSet" },
        "topology": { "$ref": "#/$defs/stringSet" },
        "adversarial": { "$ref": "#/$defs/stringSet" },
        "runtime": { "$ref": "#/$defs/stringSet" },
        "qualification": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "enum": ["implementer", "independent", "owner-waiver"] } }
      }
    }
  }
}
