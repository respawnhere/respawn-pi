{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://respawnpack.dev/schemas/requirements.schema.json",
  "title": "root requirements.json — the approved denominator",
  "description": "AUTHORED completion obligations. Executable commands are forbidden here; fenceIds resolve through the package-owned registry. Cross-reference, cycle, coverage, and contradiction checks are enforced by scripts/completion-contract.mjs.",
  "type": "object",
  "required": ["schemaVersion", "denominatorVersion", "requirements", "gates"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "denominatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.-]+)?$" },
    "requirements": {
      "type": "array", "minItems": 1, "maxItems": 512,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "gates": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "featureId": { "type": "string", "pattern": "^RP-[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$" },
    "shortString": { "type": "string", "pattern": "^.{1,512}$" },
    "stringSet": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^.{1,128}$" } },
    "dimensions": {
      "type": "object",
      "required": ["surface", "topology", "adversarial", "runtime", "qualification"],
      "additionalProperties": false,
      "properties": {
        "surface": { "$ref": "#/$defs/stringSet" },
        "topology": { "$ref": "#/$defs/stringSet" },
        "adversarial": { "$ref": "#/$defs/stringSet" },
        "runtime": { "$ref": "#/$defs/stringSet" },
        "qualification": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "enum": ["implementer", "independent", "owner-waiver"] } }
      }
    },
    "waiver": {
      "type": "object",
      "required": ["authority", "reason"],
      "additionalProperties": false,
      "properties": {
        "authority": { "enum": ["owner"] },
        "reason": { "$ref": "#/$defs/shortString" }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "featureIds", "title", "applicability", "mandatory", "risk", "priority", "gate", "fenceIds", "dependsOn", "evidenceRequirements"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "featureIds": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/featureId" } },
        "title": { "$ref": "#/$defs/shortString" },
        "applicability": { "enum": ["live", "held", "deferred", "killed-absence", "not-applicable"] },
        "mandatory": { "type": "boolean" },
        "risk": { "enum": ["normal", "high"] },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "gate": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "fenceIds": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } },
        "dependsOn": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/id" } },
        "blockedBy": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/id" } },
        "missingAuthority": { "$ref": "#/$defs/shortString" },
        "waiver": { "$ref": "#/$defs/waiver" },
        "evidenceRequirements": { "$ref": "#/$defs/dimensions" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["title", "requires"],
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/shortString" },
        "requires": { "type": "array", "minItems": 1, "maxItems": 512, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
